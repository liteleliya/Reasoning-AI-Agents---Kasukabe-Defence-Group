# Python environments, bytecode and local tool caches
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.uv-cache/

# Local settings and credentials
.env
.env.*
!.env.example
.claude/

# Downloaded benchmark cache (authored cases and manifests remain tracked)
data/mscore/

# Generated databases and archives are ignored by default. Explicit study
# outputs are re-included below so the frozen evidence can be pulled by the team.
*.sqlite
*.sqlite3
*.db
*.sqlite-shm
*.sqlite-wal
*.zip

# JavaScript and compiled frontend assets
node_modules/
ui/node_modules/
ui/dist/

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Notebook checkpoints
.ipynb_checkpoints/

# Results are private by default; only named, reviewable project artifacts are shared.
/results/*
!/results/README.md
!/results/project_results.json
!/results/paired-study/
/results/paired-study/*
!/results/paired-study/README.md
!/results/paired-study/analysis/
/results/paired-study/analysis/*
!/results/paired-study/analysis/analysis.json
!/results/paired-study/analysis/outcome_table.csv
!/results/paired-study/analysis/*.png

# Completed adaptive density run (1,680 sessions; level 3 remains partial).
!/results/proposal-density-adaptive-500/
!/results/proposal-density-adaptive-500/**
!/results/proposal-density-adaptive-500/**/*.sqlite
!/results/proposal-density-adaptive-500/**/*.sqlite3

# Completed static stage 3 (1,000 sessions).
!/results/proposal-density-static-250/
!/results/proposal-density-static-250/**
!/results/proposal-density-static-250/**/*.sqlite
!/results/proposal-density-static-250/**/*.sqlite3

# Shared-task extract and matched policy comparison supporting the report.
!/results/stage2-matched-250/
!/results/stage2-matched-250/**
!/results/proposal-policy-comparison-250/
!/results/proposal-policy-comparison-250/**

# Official-grader MedAgentBench 30-task baseline and reproducibility metadata.
!/results/medagentbench-30/
!/results/medagentbench-30/**

# Historical exploratory logs, snapshots and archived handoff copies stay local.
/results/archive/
